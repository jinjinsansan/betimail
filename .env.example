RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=support@yourdomain.com
RESEND_FROM_NAME=コミュニティサポート

ANTHROPIC_API_KEY=your_anthropic_api_key_here

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
