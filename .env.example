# ── Resend (メール送受信) ─────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=support@yourdomain.com
RESEND_FROM_NAME=beti 運営サポート
# Resend ダッシュボードの Webhook 設定で確認できる Svix シークレット
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic (AI返信生成) ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 使用モデル (省略可)
ANTHROPIC_MODEL=claude-opus-4-7

# ── Telegram (承認通知) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 複数の管理者に通知する場合は カンマ区切りで指定
TELEGRAM_CHAT_ID=000000000

# ── AI動作 ─────────────────────────────────────────────
# 自信度がこの値未満なら人手承認に回す (0.0〜1.0)
AI_CONFIDENCE_THRESHOLD=0.75
# AI返信生成時に渡す過去のやり取り件数
AI_HISTORY_DEPTH=5
# true: AI判断によらず全件 Telegram 承認に回す（自動送信なし）
ALWAYS_HUMAN_APPROVAL=true

# ── 認証 ───────────────────────────────────────────────
# 設定しないと管理画面・APIが完全公開状態になります（本番では必須）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── 動作設定 ────────────────────────────────────────────
# メンバー追加時にウェルカムメールを自動送信するか
SEND_WELCOME_EMAIL=true

# ログレベル: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
